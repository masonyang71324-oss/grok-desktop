{
  "name": "grok-desktop",
  "version": "1.8.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.0"
  },
  "description": "Grok Build desktop workspace with English and Simplified Chinese UI",
  "main": "electron/main.cjs",
  "author": "Grok Desktop",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/e2e-smoke.cjs && node tests/e2e-lifecycle.cjs && node tests/e2e-recovery.cjs && node tests/e2e-workflows.cjs && node tests/e2e-images.cjs && node tests/e2e-word.cjs && node tests/e2e-documents.cjs && node tests/e2e-upgrades.cjs && node tests/e2e-review-fixes.cjs && node tests/e2e-access.cjs && node tests/e2e-draft-force-exit.cjs",
    "test:e2e:upgrades": "node tests/e2e-upgrades.cjs",
    "bench:markdown": "node scripts/bench-markdown.cjs",
    "bench:conversation": "node scripts/bench-conversation.cjs",
    "check:upstream": "node --use-env-proxy --use-system-ca scripts/check-upstream.cjs",
    "format": "prettier --write src electron scripts tests *.json *.ts *.html *.md docs .github",
    "format:check": "prettier --check src electron scripts tests *.json *.ts *.html *.md docs .github",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "dist:signed": "npm run build && electron-builder --win nsis portable --x64 -c.win.signExecutable=true -c.forceCodeSigning=true --publish never",
    "lint:electron": "eslint electron",
    "typecheck:electron": "tsc --project tsconfig.electron.json"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "0.1.4",
    "@kenjiuno/msgreader": "1.28.0",
    "cfb": "1.2.2",
    "electron-updater": "6.8.9",
    "entities": "4.5.0",
    "html-to-text": "10.0.1",
    "iconv-lite": "0.7.3",
    "jszip": "3.10.2",
    "mailparser": "3.9.33",
    "node-pty": "1.1.0",
    "rtf-parser": "1.3.3",
    "saxes": "6.0.0",
    "toml-eslint-parser": "1.0.3",
    "word-extractor": "1.0.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "highlight.js": "^11.12.0",
    "katex": "0.19.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.12",
    "playwright": "^1.55.0",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "local.grok.desktop",
    "productName": "Grok Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "electron/voice-typing.ps1",
        "to": "voice-typing.ps1"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Grok-Desktop-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grok Desktop",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Grok-Desktop-${version}-Windows.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "masonyang71324-oss",
      "repo": "grok-desktop",
      "releaseType": "release"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
